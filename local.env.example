# Copy to local.env and fill in. Never commit local.env.
# Skills that need machine/project paths: read local.env (see local.env.example).

# App repo that provides @playwright/test (and usually e2e/ selectors)
PLAYWRIGHT_DIR=

# Demo-videos pipeline directory (scenes.mjs, record.mjs, convert.mjs, etc.)
DEMO_VIDEOS_DIR=

# Where final MP4s are written
VIDEO_OUTPUT_DIR=

# Record entrypoint relative to PLAYWRIGHT_DIR (demo-video skill)
DEMO_RECORD_SCRIPT=scripts/demo-videos/record.mjs

# E2E selectors directory relative to PLAYWRIGHT_DIR
E2E_DIR=e2e

# scripts/keepalive.py: PostgREST URL of public.alive and a publishable key
KEEPALIVE_URL=https://<project_ref>.supabase.co/rest/v1/alive
KEEPALIVE_KEY=
