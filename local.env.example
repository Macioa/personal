# Copy to local.env and fill in. Never commit local.env.
# Skills that need machine/project paths: read local.env (see local.env.example).

# App repo that provides @playwright/test (and usually e2e/ selectors)
PLAYWRIGHT_DIR=

# Demo-videos pipeline directory (scenes.mjs, record.mjs, convert.mjs, etc.)
DEMO_VIDEOS_DIR=

# Where final MP4s are written
VIDEO_OUTPUT_DIR=

# Record entrypoint relative to PLAYWRIGHT_DIR (demo-video skill)
DEMO_RECORD_SCRIPT=scripts/demo-videos/record.mjs

# E2E selectors directory relative to PLAYWRIGHT_DIR
E2E_DIR=e2e

# scripts/keepalive.py: PostgREST URL of public.alive and a publishable key
KEEPALIVE_URL=https://<project_ref>.supabase.co/rest/v1/alive
KEEPALIVE_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TELEMETRY_IGNORE_IPS=
RESUME_GEMINI_KEY=your-gemini-api-key
RESUME_GROK_KEY=your-grok-api-key

# Voicemail delete filters (scripts/voicemail/classify.py). Regex, case-insensitive. Saved contacts exempt from A/B.
VOICEMAIL_MIN_WORDS=3
VOICEMAIL_FILTER_PATTERNS_A=
VOICEMAIL_FILTER_PATTERNS_B=

# Text filters (scripts/texts/watch.ps1). Regex, case-insensitive. Saved contacts exempt.
# A: archive. B: reply STOP; C reply within TEXT_STOP_WAIT_SECONDS -> archive, else block + report.
TEXT_FILTER_PATTERNS_A=
TEXT_FILTER_PATTERNS_B=
TEXT_FILTER_PATTERNS_C=
TEXT_STOP_WAIT_SECONDS=5

# Writable temp folder on the phone for UI dumps (scripts/texts)
PHONE_TMP_DIR=
